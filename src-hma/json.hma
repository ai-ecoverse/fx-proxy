;; json.hma — spans in, spans out, over Hot Glue's reader and writer.
;;
;; The proxy navigates JSON by span: $jget hands back the bytes of a
;; value so the caller can hand them to $jget again, and $jfirst/$jnext
;; walk an array the same way. That shape is kept, because a hundred and
;; some call sites are built on it. What is gone is the hand-rolled
;; parser underneath — escapes, \uXXXX, surrogate pairs, number
;; spelling, structural skipping. All of it now comes from
;; hotglue/json-read.hma, with json-write.hma doing the escaping on the
;; way out.
;;
;; The bridge between a streaming reader and a span API is one
;; observation: after the event that ends a value, (jr-in) *is* the end
;; of that value. A string ends on its closing quote, a literal on its
;; last byte, a container on its bracket, and a number pushes its
;; delimiter back (see $jr-num-end), so the rule holds without a special
;; case. The start is the first byte after the previous event that is
;; not whitespace, a comma or a colon — nothing else can sit there.
;;
;; The reader is a single global instance and the writer shares its
;; container stack, so no function here may hold either one's state
;; across a call to another. Each entry point opens what it needs, runs
;; it to the answer, and returns bytes that live in the caller's
;; document or the caller's buffer — never in the scratch.
;;
;; The cost of this is real and worth stating: the reader tokenizes,
;; decoding every string it passes into the token buffer, where the old
;; scanner only walked bytes looking for structure. Measured against the
;; harness, a request carrying a 6 KB body costs about 6% more, 18 KB
;; about 18%, and 66 KB about 57% — call it +0.6 ms on the largest,
;; against the ~32 ms of CPU a request already spends. Paid for
;; correctness: escapes, \uXXXX, surrogate pairs and number spelling are
;; now one tested implementation shared with the rest of Hot Glue,
;; instead of a second one maintained here.

;; Scratch, in the band glue-mem.hma leaves free above the reader's own
;; block. Shared and grown rather than allocated per call: $jget is
;; called from loops, and the arena never frees.
(defmacro js-tok-p () `(i32.load (i32.const 67680)))
(defmacro js-tok-p! (v) `(i32.store (i32.const 67680) (num ,v)))
(defmacro js-tok-cap () `(i32.load (i32.const 67684)))
(defmacro js-tok-cap! (v) `(i32.store (i32.const 67684) (num ,v)))
(defmacro js-stk-p () `(i32.load (i32.const 67688)))
(defmacro js-stk-p! (v) `(i32.store (i32.const 67688) (num ,v)))
(defmacro js-out-p () `(i32.load (i32.const 67692)))
(defmacro js-out-p! (v) `(i32.store (i32.const 67692) (num ,v)))
(defmacro js-out-cap () `(i32.load (i32.const 67696)))
(defmacro js-out-cap! (v) `(i32.store (i32.const 67696) (num ,v)))

;; one bit of container stack per level: 64 bytes is 512 deep
(defmacro js-stk-bytes () `(num 64))

;; ------------------------------------------------------------ the reader

;; A token can never be longer than the text it came from, so a buffer
;; the size of the span can never overflow.
(func $js-open (param $p i32) (param $n i32)
  (let [$need (+ (local.get $n) 16)]
    (when (> (local.get $need) (js-tok-cap))
      (js-tok-p! (call $alloc (local.get $need)))
      (js-tok-cap! (local.get $need)))
    (when (zero? (js-stk-p))
      (js-stk-p! (call $alloc (js-stk-bytes))))
    (call $jr-init (js-tok-p) (js-tok-cap) (js-stk-p) (js-stk-bytes))
    (call $jr-fill (local.get $p) (local.get $n))))

;; one event; a window that runs dry means the document ended, which is
;; only an answer when the reader is between values
(func $js-next (result i32)
  (let [$ev (call $jr-next)]
    ($if (zero? (local.get $ev)) (call $jr-eof) (local.get $ev))))

(func $js-container? (param $ev i32) (result i32)
  (or (= (local.get $ev) 1) (= (local.get $ev) 3)))

;; Read one whole value. $d0 is the nesting depth *before* its first
;; event, so a container is drained back to where it started rather
;; than all the way out — a nested object inside the one being scanned
;; must not swallow its parent's closing brace.
(func $js-whole (param $ev i32) (param $d0 i32) (result i32)
  (when (not (call $js-container? (local.get $ev))) (return (local.get $ev)))
  (while (> (jr-depth) (local.get $d0))
    (local.set $ev (call $js-next))
    (when (neg? (local.get $ev)) (return (local.get $ev))))
  (local.get $ev))

;; where the value after $from begins: only whitespace, a comma or a
;; colon can stand between the last event and it
(func $js-vstart (param $from i32) (result i32)
  (let [$c 0]
    (while (< (local.get $from) (jr-end))
      (local.set $c (i32.load8_u (local.get $from)))
      (when (and (not (call $ws? (local.get $c)))
                 (and (not= (local.get $c) 44) (not= (local.get $c) 58)))
        (return (local.get $from)))
      (local.set $from (inc (local.get $from))))
    (local.get $from)))

;; ------------------------------------------------------------ navigation

(func $jws (param $p i32) (param $e i32) (result i32)
  (while (and (< (local.get $p) (local.get $e))
              (call $ws? (i32.load8_u (local.get $p))))
    (local.set $p (inc (local.get $p))))
  (local.get $p))

;; p at the first byte of a value; result: the byte after it
(func $jskip (param $p i32) (param $e i32) (result i32)
  (let [$ev 0]
    (when (>= (local.get $p) (local.get $e)) (return (local.get $e)))
    (call $js-open (local.get $p) (- (local.get $e) (local.get $p)))
    (local.set $ev (call $js-whole (call $js-next) (num 0)))
    ($if (neg? (local.get $ev)) (local.get $e) (jr-in))))

;; p at an opening quote; result: the position after the closing quote
(func $jstr-end (param $p i32) (param $e i32) (result i32)
  (call $jskip (local.get $p) (local.get $e)))

;; the value at $kp in the object spanning (p, e), as a cell (start end)
(func $jget (param $p i32) (param $e i32) (param $kp i32) (param $kn i32) (result i32)
  (let [$ev 0 $pre 0 $start 0 $hit 0 $d0 0]
    (when (>= (local.get $p) (local.get $e)) (return (num 0)))
    (call $js-open (local.get $p) (- (local.get $e) (local.get $p)))
    (when (not= (call $js-next) (num 1)) (return (num 0)))
    (while (num 1)
      (local.set $ev (call $js-next))
      (when (not= (local.get $ev) (num 5)) (return (num 0)))
      (local.set $hit (call $str-eq (jr-tok-ptr) (jr-tok-len)
                            (local.get $kp) (local.get $kn)))
      (local.set $pre (jr-in))
      (local.set $d0 (jr-depth))
      (local.set $ev (call $js-next))
      (when (neg? (local.get $ev)) (return (num 0)))
      (local.set $start (call $js-vstart (local.get $pre)))
      (local.set $ev (call $js-whole (local.get $ev) (local.get $d0)))
      (when (neg? (local.get $ev)) (return (num 0)))
      (when (local.get $hit)
        (return (call $cell (local.get $start) (jr-in)))))
    (num 0)))

;; first element of the array spanning (p, e); a pointer, or 0
(func $jfirst (param $p i32) (param $e i32) (result i32)
  (let [$pre 0 $ev 0]
    (when (>= (local.get $p) (local.get $e)) (return (num 0)))
    (call $js-open (local.get $p) (- (local.get $e) (local.get $p)))
    (when (not= (call $js-next) (num 3)) (return (num 0)))
    (local.set $pre (jr-in))
    (local.set $ev (call $js-next))
    (when (or (neg? (local.get $ev)) (= (local.get $ev) (num 4))) (return (num 0)))
    (call $js-vstart (local.get $pre))))

;; the element after a value ending at $ve; structural, so it stays a
;; byte walk — there is nothing here to parse
(func $jnext (param $ve i32) (param $e i32) (result i32)
  (let [$p (call $jws (local.get $ve) (local.get $e))]
    ($if (and (< (local.get $p) (local.get $e))
              (= (i32.load8_u (local.get $p)) 44))
         (call $jws (inc (local.get $p)) (local.get $e))
         (num 0))))

(func $jcount (param $p i32) (param $e i32) (result i32)
  (let [$v (call $jfirst (local.get $p) (local.get $e)) $n 0]
    (while (local.get $v)
      (local.set $n (inc (local.get $n)))
      (local.set $v (call $jnext (call $jskip (local.get $v) (local.get $e)) (local.get $e))))
    (local.get $n)))

;; ------------------------------------------------------------ contents

;; decode the string value at (p, e) into $buf — escapes unwound,
;; \uXXXX minted as UTF-8, surrogate pairs fused, all by the reader
(func $jstr (param $p i32) (param $e i32) (param $buf i32)
  (let [$ev 0]
    (when (>= (local.get $p) (local.get $e)) (return))
    (call $js-open (local.get $p) (- (local.get $e) (local.get $p)))
    (local.set $ev (call $js-next))
    (when (or (= (local.get $ev) (num 6)) (= (local.get $ev) (num 5)))
      (call $append (local.get $buf) (jr-tok-ptr) (jr-tok-len)))))

(func $jstr-cell (param $vc i32) (result i32)
  (let [$b (call $buf-new (num 64))]
    (call $jstr (c0 (local.get $vc)) (c1 (local.get $vc)) (local.get $b))
    (call $cell (buf-ptr (local.get $b)) (buf-len (local.get $b)))))

;; integer part of the number at (p, e); cell (ok val). The reader
;; settles what counts as a number; $parse-int reads the integer part
;; off its spelling, which is all the proxy ever wants and keeps wide
;; and fractional values behaving as they always did.
;; how much of a number's spelling is its integer part
(func $js-int-prefix (param $p i32) (param $n i32) (result i32)
  (let [$i 0 $c 0]
    (while (< (local.get $i) (local.get $n))
      (local.set $c (i32.load8_u (+ (local.get $p) (local.get $i))))
      (when (and (not= (local.get $c) 45)
                 (or (< (local.get $c) 48) (> (local.get $c) 57)))
        (return (local.get $i)))
      (local.set $i (inc (local.get $i))))
    (local.get $n)))

(func $jint (param $p i32) (param $e i32) (result i32)
  (let [$ev 0]
    (when (>= (local.get $p) (local.get $e)) (return (call $cell (num 0) (num 0))))
    (call $js-open (local.get $p) (- (local.get $e) (local.get $p)))
    (local.set $ev (call $js-next))
    (when (not= (local.get $ev) (num 7)) (return (call $cell (num 0) (num 0))))
    (call $parse-int (jr-tok-ptr)
          (call $js-int-prefix (jr-tok-ptr) (jr-tok-len)))))

;; ------------------------------------------------------------ shapes
;; One byte tells them apart, and every caller already holds a value's
;; first byte. Nothing to parse.

(func $jtrue? (param $p i32) (param $e i32) (result i32)
  (call $str-eq (local.get $p) (- (local.get $e) (local.get $p)) "true"))
(func $jnull? (param $p i32) (param $e i32) (result i32)
  (call $str-eq (local.get $p) (- (local.get $e) (local.get $p)) "null"))
(func $jstring? (param $p i32) (result i32)
  (= (i32.load8_u (local.get $p)) 34))
(func $jobject? (param $p i32) (result i32)
  (= (i32.load8_u (local.get $p)) 123))
(func $jarray? (param $p i32) (result i32)
  (= (i32.load8_u (local.get $p)) 91))
(func $jnumber? (param $p i32) (result i32)
  (let [$c (i32.load8_u (local.get $p))]
    (or (= (local.get $c) 45) (and (>= (local.get $c) 48) (<= (local.get $c) 57)))))

;; ------------------------------------------------------------ writing

;; json-write escapes into a buffer of its own, so the bytes are copied
;; once on the way to the caller's. Worst case is six bytes per input
;; byte (\u00XX) plus the two quotes.
(func $js-quote (param $p i32) (param $n i32)
  (let [$need (+ (* (local.get $n) 6) 32)]
    (when (> (local.get $need) (js-out-cap))
      (js-out-p! (call $alloc (local.get $need)))
      (js-out-cap! (local.get $need)))
    (when (zero? (js-stk-p))
      (js-stk-p! (call $alloc (js-stk-bytes))))
    (call $jw-init (js-out-p) (js-out-cap) (js-stk-p) (js-stk-bytes))
    (call $jw-str (local.get $p) (local.get $n))))

;; the escaped body, without the quotes
(func $jesc (param $buf i32) (param $p i32) (param $n i32)
  (call $js-quote (local.get $p) (local.get $n))
  (call $append (local.get $buf) (inc (jw-buf)) (- (jw-len) 2)))

;; the escaped body, with them
(func $jqstr (param $buf i32) (param $p i32) (param $n i32)
  (call $js-quote (local.get $p) (local.get $n))
  (call $append (local.get $buf) (jw-buf) (jw-len)))
