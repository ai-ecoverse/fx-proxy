;; assemble.hma — agent events in, Responses API out: the output items,
;; the SSE stream, and the final response object, from one state.
;;
;; Item records, 28 bytes each in the items buffer:
;;   [0 type: 0 message, 1 reasoning, 2 web_search_call]
;;   [4 status: 0 in_progress, 1 completed, 2 failed]
;;   [8 id-p][12 id-n]
;;   [16 text buffer (message/reasoning content)]
;;   [20 action kind: 0 search, 1 open_page]
;;   [24 action text buffer]

(defmacro item-at (i) `(+ (buf-ptr (get-items-b)) (i32.mul (num ,i) (i32.const 28))))

(func $as-init
  (set-items-b (call $buf-new (num 256)))
  (set-items-n (num 0))
  (set-open-msg (num -1))
  (set-open-rsn (num -1))
  (set-seq (num 0))
  (set-toolcalls (num 0))
  (set-errcode-p (num 0)) (set-errcode-n (num 0))
  (set-errmsg-p (num 0)) (set-errmsg-n (num 0))
  (set-stop-p (num 0)) (set-stop-n (num 0))
  (set-modelreqs (num 0))
  (set-usage-in (num 0)) (set-usage-out (num 0))
  (set-status (num 0))
  (set-incomplete (num 0))
  (set-authfails (num 0))
  (set-sse-open (num 0)))

(func $item-new (param $type i32) (result i32)
  (let [$b (get-items-b) $r 0]
    (call $buf-reserve (local.get $b) (num 28))
    (local.set $r (buf-end (local.get $b)))
    (memory.fill (local.get $r) (num 0) (num 28))
    (i32.store (local.get $r) (local.get $type))
    (i32.store (+ (local.get $b) 4) (+ (buf-len (local.get $b)) 28))
    (set-items-n (inc (get-items-n)))
    (dec (get-items-n))))

;; ------------------------------------------------------------- printing

(func $status-str (param $s i32) (param $b i32)
  (cond
    (= (local.get $s) 1) (splice (call $append (local.get $b) "completed") (num 0))
    (= (local.get $s) 2) (splice (call $append (local.get $b) "failed") (num 0))
    :else (splice (call $append (local.get $b) "in_progress") (num 0)))
  (drop))

(func $item-json (param $b i32) (param $i i32)
  (let [$r (item-at (local.get $i)) $type 0 $tb 0]
    (local.set $type (i32.load (local.get $r)))
    (call $append (local.get $b) "{\"id\":")
    (call $jqstr (local.get $b) (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12)))
    (cond
      (zero? (local.get $type))
        (splice
          (call $append (local.get $b) ",\"type\":\"message\",\"status\":\"")
          (call $status-str (i32.load (+ (local.get $r) 4)) (local.get $b))
          (call $append (local.get $b) "\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":")
          (local.set $tb (i32.load (+ (local.get $r) 16)))
          (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
          (call $append (local.get $b) ",\"annotations\":[]}]}")
          (num 0))
      (= (local.get $type) 1)
        (splice
          (call $append (local.get $b) ",\"type\":\"reasoning\",\"status\":\"")
          (call $status-str (i32.load (+ (local.get $r) 4)) (local.get $b))
          (call $append (local.get $b) "\",\"summary\":[{\"type\":\"summary_text\",\"text\":")
          (local.set $tb (i32.load (+ (local.get $r) 16)))
          (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
          (call $append (local.get $b) "}]}")
          (num 0))
      :else
        (splice
          (call $append (local.get $b) ",\"type\":\"web_search_call\",\"status\":\"")
          (call $status-str (i32.load (+ (local.get $r) 4)) (local.get $b))
          (call $append (local.get $b) "\",\"action\":{\"type\":\"")
          (if (i32.load (+ (local.get $r) 20))
            (then (call $append (local.get $b) "open_page\",\"url\":"))
            (else (call $append (local.get $b) "search\",\"query\":")))
          (local.set $tb (i32.load (+ (local.get $r) 24)))
          (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
          (call $append (local.get $b) "}}")
          (num 0)))
    (drop)))

(func $snapshot (param $b i32)
  (let [$i 0 $r 0 $tb 0]
    (call $append (local.get $b) "{\"id\":")
    (call $jqstr (local.get $b) (get-respid-p) (get-respid-n))
    (call $append (local.get $b) ",\"object\":\"response\",\"created_at\":")
    (call $append-int (local.get $b) (get-now))
    (call $append (local.get $b) ",\"status\":\"")
    (cond
      (= (get-status) 1) (splice (call $append (local.get $b) "completed") (num 0))
      (= (get-status) 2) (splice (call $append (local.get $b) "incomplete") (num 0))
      (= (get-status) 3) (splice (call $append (local.get $b) "failed") (num 0))
      (= (get-status) 4) (splice (call $append (local.get $b) "cancelled") (num 0))
      :else (splice (call $append (local.get $b) "in_progress") (num 0)))
    (drop)
    (call $append (local.get $b) "\",\"background\":false,\"error\":")
    (if (pos? (get-errcode-n))
      (then
        (call $append (local.get $b) "{\"code\":")
        (call $jqstr (local.get $b) (get-errcode-p) (get-errcode-n))
        (call $append (local.get $b) ",\"message\":")
        (call $jqstr (local.get $b) (get-errmsg-p) (get-errmsg-n))
        (call $append (local.get $b) "}"))
      (else (call $append (local.get $b) "null")))
    (call $append (local.get $b) ",\"incomplete_details\":")
    (if (get-incomplete)
      (then (call $append (local.get $b) "{\"reason\":\"max_output_tokens\"}"))
      (else (call $append (local.get $b) "null")))
    (call $append (local.get $b) ",\"instructions\":")
    (if (get-instr-p)
      (then (call $jqstr (local.get $b) (get-instr-p) (get-instr-n)))
      (else (call $append (local.get $b) "null")))
    (call $append (local.get $b) ",\"max_output_tokens\":")
    (if (>= (get-maxout) 0)
      (then (call $append-int (local.get $b) (get-maxout)))
      (else (call $append (local.get $b) "null")))
    (call $append (local.get $b) ",\"metadata\":")
    (if (pos? (get-meta-n))
      (then (call $append (local.get $b) (get-meta-p) (get-meta-n)))
      (else (call $append (local.get $b) "{}")))
    (call $append (local.get $b) ",\"model\":")
    (call $jqstr (local.get $b) (get-model-p) (get-model-n))
    (call $append (local.get $b) ",\"output\":[")
    (while (< (local.get $i) (get-items-n))
      (when (pos? (local.get $i)) (call $append (local.get $b) ","))
      (call $item-json (local.get $b) (local.get $i))
      (local.set $i (inc (local.get $i))))
    (call $append (local.get $b) "],\"output_text\":\"")
    (local.set $i (num 0))
    (while (< (local.get $i) (get-items-n))
      (local.set $r (item-at (local.get $i)))
      (when (zero? (i32.load (local.get $r)))
        (local.set $tb (i32.load (+ (local.get $r) 16)))
        (call $jesc (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb))))
      (local.set $i (inc (local.get $i))))
    (call $append (local.get $b) "\",\"parallel_tool_calls\":false,\"previous_response_id\":null,\"store\":false,\"temperature\":null,\"tool_choice\":\"auto\",\"tools\":[{\"type\":\"web_search\"}],\"top_p\":null,\"truncation\":\"disabled\",\"usage\":{\"input_tokens\":")
    (call $append-int (local.get $b) (get-usage-in))
    (call $append (local.get $b) ",\"input_tokens_details\":{\"cached_tokens\":0},\"output_tokens\":")
    (call $append-int (local.get $b) (get-usage-out))
    (call $append (local.get $b) ",\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":")
    (call $append-int (local.get $b) (+ (get-usage-in) (get-usage-out)))
    (call $append (local.get $b) "},\"user\":null,\"fx\":{\"stop_reason\":")
    (if (pos? (get-stop-n))
      (then (call $jqstr (local.get $b) (get-stop-p) (get-stop-n)))
      (else (call $append (local.get $b) "\"unknown\"")))
    (call $append (local.get $b) ",\"model_requests\":")
    (call $append-int (local.get $b) (get-modelreqs))
    (call $append (local.get $b) ",\"tool_calls\":")
    (call $append-int (local.get $b) (get-toolcalls))
    (call $append (local.get $b) ",\"agent\":\"hotglue\",\"runtime\":\"cloudflare-workers\"}}")))

;; --------------------------------------------------------------- events

;; "event: T\ndata: {"type":"T","sequence_number":N" — caller closes
(func $ev-head (param $b i32) (param $tp i32) (param $tn i32)
  (set-seq (inc (get-seq)))
  (call $append (local.get $b) "event: ")
  (call $append (local.get $b) (local.get $tp) (local.get $tn))
  (call $append (local.get $b) "\ndata: {\"type\":\"")
  (call $append (local.get $b) (local.get $tp) (local.get $tn))
  (call $append (local.get $b) "\",\"sequence_number\":")
  (call $append-int (local.get $b) (get-seq)))

(func $ev-send (param $b i32)
  (call $append (local.get $b) "}\n\n")
  (call $host-emit (buf-ptr (local.get $b)) (buf-len (local.get $b))))

(defmacro streaming? () `(i32.and (get-stream) (get-sse-open)))

;; item id of record i as (p n) onto a buffer append
(func $append-item-id (param $b i32) (param $i i32)
  (let [$r (item-at (local.get $i))]
    (call $jqstr (local.get $b) (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12)))))

;; event with response snapshot payload
(func $ev-response (param $tp i32) (param $tn i32)
  (let [$b 0]
    (when (not (streaming?)) (return))
    (local.set $b (call $buf-new (num 2048)))
    (call $ev-head (local.get $b) (local.get $tp) (local.get $tn))
    (call $append (local.get $b) ",\"response\":")
    (call $snapshot (local.get $b))
    (call $ev-send (local.get $b))))

;; output_item added/done events
(func $ev-item (param $tp i32) (param $tn i32) (param $i i32)
  (let [$b 0]
    (when (not (streaming?)) (return))
    (local.set $b (call $buf-new (num 512)))
    (call $ev-head (local.get $b) (local.get $tp) (local.get $tn))
    (call $append (local.get $b) ",\"output_index\":")
    (call $append-int (local.get $b) (local.get $i))
    (call $append (local.get $b) ",\"item\":")
    (call $item-json (local.get $b) (local.get $i))
    (call $ev-send (local.get $b))))

;; web_search_call.* progress events carry output_index + item_id
(func $ev-ws (param $tp i32) (param $tn i32) (param $i i32)
  (let [$b 0]
    (when (not (streaming?)) (return))
    (local.set $b (call $buf-new (num 256)))
    (call $ev-head (local.get $b) (local.get $tp) (local.get $tn))
    (call $append (local.get $b) ",\"output_index\":")
    (call $append-int (local.get $b) (local.get $i))
    (call $append (local.get $b) ",\"item_id\":")
    (call $append-item-id (local.get $b) (local.get $i))
    (call $ev-send (local.get $b))))

;; ----------------------------------------------------- open/close items

(func $mk-id (param $prefixp i32) (param $prefixn i32) (param $i i32) (result i32)
  ;; "<prefix><i>_<last 8 of the response id>"
  (let [$b (call $buf-new (num 32)) $tail 0]
    (call $append (local.get $b) (local.get $prefixp) (local.get $prefixn))
    (call $append-int (local.get $b) (local.get $i))
    (call $append (local.get $b) "_")
    (local.set $tail ($if (> (get-respid-n) 8) (num 8) (get-respid-n)))
    (call $append (local.get $b) (+ (get-respid-p) (- (get-respid-n) (local.get $tail))) (local.get $tail))
    (call $cell (buf-ptr (local.get $b)) (buf-len (local.get $b)))))

(func $open-part-event (param $i i32) (param $reasoning i32)
  ;; content_part.added / reasoning_summary_part.added
  (let [$b 0]
    (when (not (streaming?)) (return))
    (local.set $b (call $buf-new (num 256)))
    (if (local.get $reasoning)
      (then (call $ev-head (local.get $b) "response.reasoning_summary_part.added"))
      (else (call $ev-head (local.get $b) "response.content_part.added")))
    (call $append (local.get $b) ",\"item_id\":")
    (call $append-item-id (local.get $b) (local.get $i))
    (call $append (local.get $b) ",\"output_index\":")
    (call $append-int (local.get $b) (local.get $i))
    (if (local.get $reasoning)
      (then (call $append (local.get $b) ",\"summary_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"\"}"))
      (else (call $append (local.get $b) ",\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":\"\",\"annotations\":[]}")))
    (call $ev-send (local.get $b))))

(func $close-msg
  (let [$i (get-open-msg) $r 0 $tb 0 $b 0]
    (when (neg? (local.get $i)) (return))
    (set-open-msg (num -1))
    (local.set $r (item-at (local.get $i)))
    (i32.store (+ (local.get $r) 4) (num 1))
    (when (streaming?)
      (local.set $tb (i32.load (+ (local.get $r) 16)))
      (local.set $b (call $buf-new (num 512)))
      (call $ev-head (local.get $b) "response.output_text.done")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"content_index\":0,\"text\":")
      (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
      (call $ev-send (local.get $b))
      (local.set $b (call $buf-new (num 512)))
      (call $ev-head (local.get $b) "response.content_part.done")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":")
      (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
      (call $append (local.get $b) ",\"annotations\":[]}")
      (call $ev-send (local.get $b))
      (call $ev-item "response.output_item.done" (local.get $i)))))

(func $close-rsn
  (let [$i (get-open-rsn) $r 0 $tb 0 $b 0]
    (when (neg? (local.get $i)) (return))
    (set-open-rsn (num -1))
    (local.set $r (item-at (local.get $i)))
    (i32.store (+ (local.get $r) 4) (num 1))
    (when (streaming?)
      (local.set $tb (i32.load (+ (local.get $r) 16)))
      (local.set $b (call $buf-new (num 512)))
      (call $ev-head (local.get $b) "response.reasoning_summary_text.done")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"summary_index\":0,\"text\":")
      (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
      (call $ev-send (local.get $b))
      (local.set $b (call $buf-new (num 512)))
      (call $ev-head (local.get $b) "response.reasoning_summary_part.done")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"summary_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":")
      (call $jqstr (local.get $b) (buf-ptr (local.get $tb)) (buf-len (local.get $tb)))
      (call $append (local.get $b) "}")
      (call $ev-send (local.get $b))
      (call $ev-item "response.output_item.done" (local.get $i)))))

;; ------------------------------------------------------- event handlers

(func $as-text (param $p i32) (param $n i32)
  (let [$i 0 $r 0 $id 0 $b 0]
    (call $close-rsn)
    (when (neg? (get-open-msg))
      (local.set $i (call $item-new (num 0)))
      (local.set $r (item-at (local.get $i)))
      (local.set $id (call $mk-id "msg_" (local.get $i)))
      (i32.store (+ (local.get $r) 8) (c0 (local.get $id)))
      (i32.store (+ (local.get $r) 12) (c1 (local.get $id)))
      (i32.store (+ (local.get $r) 16) (call $buf-new (num 256)))
      (set-open-msg (local.get $i))
      (call $ev-item "response.output_item.added" (local.get $i))
      (call $open-part-event (local.get $i) (num 0)))
    (local.set $i (get-open-msg))
    (local.set $r (item-at (local.get $i)))
    (call $append (i32.load (+ (local.get $r) 16)) (local.get $p) (local.get $n))
    (when (streaming?)
      (local.set $b (call $buf-new (+ (local.get $n) 128)))
      (call $ev-head (local.get $b) "response.output_text.delta")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"content_index\":0,\"delta\":")
      (call $jqstr (local.get $b) (local.get $p) (local.get $n))
      (call $ev-send (local.get $b)))))

(func $as-reasoning (param $p i32) (param $n i32)
  (let [$i 0 $r 0 $id 0 $b 0]
    (call $close-msg)
    (when (neg? (get-open-rsn))
      (local.set $i (call $item-new (num 1)))
      (local.set $r (item-at (local.get $i)))
      (local.set $id (call $mk-id "rs_" (local.get $i)))
      (i32.store (+ (local.get $r) 8) (c0 (local.get $id)))
      (i32.store (+ (local.get $r) 12) (c1 (local.get $id)))
      (i32.store (+ (local.get $r) 16) (call $buf-new (num 256)))
      (set-open-rsn (local.get $i))
      (call $ev-item "response.output_item.added" (local.get $i))
      (call $open-part-event (local.get $i) (num 1)))
    (local.set $i (get-open-rsn))
    (local.set $r (item-at (local.get $i)))
    (call $append (i32.load (+ (local.get $r) 16)) (local.get $p) (local.get $n))
    (when (streaming?)
      (local.set $b (call $buf-new (+ (local.get $n) 128)))
      (call $ev-head (local.get $b) "response.reasoning_summary_text.delta")
      (call $append (local.get $b) ",\"item_id\":")
      (call $append-item-id (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"output_index\":")
      (call $append-int (local.get $b) (local.get $i))
      (call $append (local.get $b) ",\"summary_index\":0,\"delta\":")
      (call $jqstr (local.get $b) (local.get $p) (local.get $n))
      (call $ev-send (local.get $b)))))

;; toolid decides the action type; display text is the query/url/path
(func $as-tool-start (param $toolid i32) (param $dp i32) (param $dn i32) (result i32)
  (let [$i 0 $r 0 $idb 0 $ab 0 $nn 0]
    (call $close-msg)
    (call $close-rsn)
    (local.set $i (call $item-new (num 2)))
    (local.set $r (item-at (local.get $i)))
    ;; id: ws_call_NNN (zero-padded)
    (local.set $idb (call $buf-new (num 16)))
    (call $append (local.get $idb) "ws_call_")
    (local.set $nn (get-toolcalls))
    (when (< (local.get $nn) 100) (call $append (local.get $idb) "0"))
    (when (< (local.get $nn) 10) (call $append (local.get $idb) "0"))
    (call $append-int (local.get $idb) (local.get $nn))
    (i32.store (+ (local.get $r) 8) (buf-ptr (local.get $idb)))
    (i32.store (+ (local.get $r) 12) (buf-len (local.get $idb)))
    (i32.store (+ (local.get $r) 20)
      ($if (or (= (local.get $toolid) 2) (= (local.get $toolid) 4)) (num 1) (num 0)))
    (local.set $ab (call $buf-new (num 64)))
    (call $append (local.get $ab) (local.get $dp) (local.get $dn))
    (i32.store (+ (local.get $r) 24) (local.get $ab))
    (call $ev-item "response.output_item.added" (local.get $i))
    (call $ev-ws "response.web_search_call.in_progress" (local.get $i))
    (call $ev-ws "response.web_search_call.searching" (local.get $i))
    (local.get $i)))

(func $as-tool-end (param $i i32) (param $iserr i32)
  (let [$r (item-at (local.get $i))]
    (i32.store (+ (local.get $r) 4) ($if (local.get $iserr) (num 2) (num 1)))
    (call $ev-ws "response.web_search_call.completed" (local.get $i))
    (call $ev-item "response.output_item.done" (local.get $i))))

(func $as-error (param $isauth i32) (param $p i32) (param $n i32)
  (let [$cb (call $buf-new (num 24))]
    (if (local.get $isauth)
      (then (call $append (local.get $cb) "invalid_api_key"))
      (else (call $append (local.get $cb) "fx_runtime_error")))
    (set-errcode-p (buf-ptr (local.get $cb)))
    (set-errcode-n (buf-len (local.get $cb)))
    (set-errmsg-p (local.get $p))
    (set-errmsg-n (local.get $n))))

(func $as-done (param $p i32) (param $n i32)
  (set-stop-p (local.get $p))
  (set-stop-n (local.get $n)))

(func $as-start
  (call $ev-response "response.created")
  (call $ev-response "response.in_progress"))

;; closes everything, resolves status, emits the terminal event
(func $as-finish
  (let [$i 0 $r 0]
    (call $close-msg)
    (call $close-rsn)
    ;; any still-open tool call failed
    (while (< (local.get $i) (get-items-n))
      (local.set $r (item-at (local.get $i)))
      (when (and (= (i32.load (local.get $r)) 2)
                 (zero? (i32.load (+ (local.get $r) 4))))
        (i32.store (+ (local.get $r) 4) (num 2))
        (call $ev-item "response.output_item.done" (local.get $i)))
      (local.set $i (inc (local.get $i))))
    (cond
      (pos? (get-errcode-n)) (splice (set-status (num 3)) (num 0))
      (call $str-eq (get-stop-p) (get-stop-n) "cancelled")
        (splice (set-status (num 4)) (num 0))
      (call $str-eq (get-stop-p) (get-stop-n) "max_tokens")
        (splice (set-status (num 2)) (set-incomplete (num 1)) (num 0))
      :else (splice (set-status (num 1)) (num 0)))
    (drop)
    (cond
      (= (get-status) 3) (splice (call $ev-response "response.failed") (num 0))
      (= (get-status) 2) (splice (call $ev-response "response.incomplete") (num 0))
      :else (splice (call $ev-response "response.completed") (num 0)))
    (drop)))
