;; worker.hma — the fx-proxy Cloudflare Worker as one Hot Glue module.
;;
;; The JS shim only moves bytes: the request arrives as one frame (see
;; frame.hma), `handle` returns a response frame, `host.fetch` is the
;; single suspending capability, `host.emit` streams SSE chunks, and
;; `host.stream_start` flips the response into an event stream.

(use clj.hma)

(module
  (import "host" "fetch" (func $host-fetch (param i32 i32) (result i32)))
  (import "host" "emit" (func $host-emit (param i32 i32)))
  (import "host" "log" (func $host-log (param i32 i32)))
  (import "host" "stream_start" (func $host-stream-start))
  ;; fx-core embedding: the host holds fx-core's memory and _start, and
  ;; mediates every cross-instance byte copy so no multi-memory is needed.
  (import "host" "gread" (func $host-gread (param i32 i32 i32)))
  (import "host" "gwrite" (func $host-gwrite (param i32 i32 i32)))
  (import "host" "fx_start" (func $host-fx-start (result i32)))
  (import "host" "sleep" (func $host-sleep (param i32)))
  (import "host" "fetch_open" (func $host-fetch-open (param i32 i32 i32) (result i32)))
  (import "host" "fetch_next" (func $host-fetch-next (param i32 i32 i32) (result i32)))
  (import "host" "fetch_close" (func $host-fetch-close (param i32)))
  (memory (export "memory") 64)

  ;; reported by /health and in the response's `fx` block
  (defmacro runtime-name () `"cloudflare-workers")

  ;; host tools that need to reach an arbitrary origin
  (defmacro web-fetch-tool? () `(num 1))
  (defmacro kb-tools? () `(num 1))

  (use worker-core.hma)

  ;; JSPI unwinds fx's proc_exit trap into a rejected promise that the shim
  ;; catches, so $fx-drive resumes on its own and there is nothing to do.
  (func $on-fx-exit)
)
