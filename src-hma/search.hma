;; search.hma — the eight search providers of src/tools/search.ts.
;;
;; Results collect into a list buffer of 24-byte records
;; [tp tn up un sp sn]; $search renders the tool output text and sets
;; the tool-err / tool-count slots.

(defmacro ua () `"Mozilla/5.0 (compatible; fx-proxy/0.1; +https://github.com/ai-ecoverse/fx-proxy)")

;; clean(): collapse(decodeEntities(stripTags(x)))
(func $clean (param $p i32) (param $n i32) (result i32)
  (let [$t1 (call $buf-new (local.get $n))
        $t2 (call $buf-new (local.get $n))
        $out (call $buf-new (local.get $n))]
    (call $strip-tags (local.get $p) (local.get $n) (local.get $t1))
    (call $ent-dec (buf-ptr (local.get $t1)) (buf-len (local.get $t1)) (local.get $t2))
    (call $collapse (buf-ptr (local.get $t2)) (buf-len (local.get $t2)) (local.get $out))
    (call $cell (buf-ptr (local.get $out)) (buf-len (local.get $out)))))

(func $sr-new (result i32)
  (call $buf-new (num 512)))

;; (ptr len) cell -> (ptr end) span cell, for JSON navigation
(func $as-span (param $c i32) (result i32)
  (call $cell (c0 (local.get $c)) (+ (c0 (local.get $c)) (c1 (local.get $c)))))

(defmacro sr-count (list) `(i32.div_u (buf-len (num ,list)) (i32.const 24)))
(defmacro sr-at (list i) `(+ (buf-ptr (num ,list)) (i32.mul (num ,i) (i32.const 24))))

;; add unless the url is empty or already present
(func $sr-add (param $list i32) (param $tp i32) (param $tn i32)
                (param $up i32) (param $un i32) (param $sp i32) (param $sn i32)
  (let [$i 0 $r 0]
    (when (zero? (local.get $un)) (return))
    (while (< (local.get $i) (sr-count (local.get $list)))
      (local.set $r (sr-at (local.get $list) (local.get $i)))
      (when (call $str-eq (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12))
                  (local.get $up) (local.get $un))
        (return))
      (local.set $i (inc (local.get $i))))
    (call $buf-reserve (local.get $list) (num 24))
    (local.set $r (buf-end (local.get $list)))
    (i32.store (local.get $r) (local.get $tp))
    (i32.store (+ (local.get $r) 4) (local.get $tn))
    (i32.store (+ (local.get $r) 8) (local.get $up))
    (i32.store (+ (local.get $r) 12) (local.get $un))
    (i32.store (+ (local.get $r) 16) (local.get $sp))
    (i32.store (+ (local.get $r) 20) (local.get $sn))
    (i32.store (+ (local.get $list) 4) (+ (buf-len (local.get $list)) 24))))

;; add from decoded-string cells (0 allowed for title/snippet)
(func $sr-add-cells (param $list i32) (param $t i32) (param $u i32) (param $s i32)
  (when (zero? (local.get $u)) (return))
  (call $sr-add (local.get $list)
    ($if (local.get $t) (c0 (local.get $t)) (num 0))
    ($if (local.get $t) (c1 (local.get $t)) (num 0))
    (c0 (local.get $u)) (c1 (local.get $u))
    ($if (local.get $s) (c0 (local.get $s)) (num 0))
    ($if (local.get $s) (c1 (local.get $s)) (num 0))))

;; ------------------------------------------------------------- rendering

(func $render-results (param $list i32) (param $qp i32) (param $qn i32)
                        (param $count i32) (param $out i32)
  (let [$n (sr-count (local.get $list)) $i 0 $r 0]
    (when (> (local.get $n) (local.get $count))
      (local.set $n (local.get $count)))
    (call $append-int (local.get $out) (local.get $n))
    (call $append (local.get $out) " results for: ")
    (call $append (local.get $out) (local.get $qp) (local.get $qn))
    (call $append (local.get $out) "\n\n")
    (while (< (local.get $i) (local.get $n))
      (local.set $r (sr-at (local.get $list) (local.get $i)))
      (when (pos? (local.get $i)) (call $append (local.get $out) "\n\n"))
      (call $append-int (local.get $out) (inc (local.get $i)))
      (call $append (local.get $out) ". ")
      (if (pos? (i32.load (+ (local.get $r) 4)))
        (then (call $append (local.get $out) (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))))
        (else (call $append (local.get $out) (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12)))))
      (call $append (local.get $out) "\n   ")
      (call $append (local.get $out) (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12)))
      (when (pos? (i32.load (+ (local.get $r) 20)))
        (call $append (local.get $out) "\n   ")
        (call $append (local.get $out) (i32.load (+ (local.get $r) 16)) (i32.load (+ (local.get $r) 20))))
      (local.set $i (inc (local.get $i))))
    (set-tool-count (local.get $n))))

;; --------------------------------------------------------- provider glue

;; !ok -> write "<provider> search failed with HTTP N[: body300]" to out; 1 on error
(func $http-guard (param $resp i32) (param $namep i32) (param $namen i32) (param $out i32) (result i32)
  (let [$st (call $resp-status (local.get $resp)) $body 0 $n 0]
    (when (and (>= (local.get $st) 200) (< (local.get $st) 300))
      (return (num 0)))
    (call $append (local.get $out) (local.get $namep) (local.get $namen))
    (call $append (local.get $out) " search failed with HTTP ")
    (call $append-int (local.get $out) (local.get $st))
    (local.set $body (call $resp-body (local.get $resp)))
    (local.set $n (c1 (local.get $body)))
    (when (pos? (local.get $n))
      (when (> (local.get $n) 300) (local.set $n (num 300)))
      (call $append (local.get $out) ": ")
      (call $append (local.get $out) (c0 (local.get $body)) (local.get $n)))
    (set-tool-err (num 1))
    (num 1)))

;; extract a string field from a JSON object into a decoded cell, or 0
(func $jfield-str (param $op i32) (param $oe i32) (param $kp i32) (param $kn i32) (result i32)
  (let [$v (call $jget (local.get $op) (local.get $oe) (local.get $kp) (local.get $kn))]
    (when (zero? (local.get $v)) (return (num 0)))
    (when (not (call $jstring? (c0 (local.get $v)))) (return (num 0)))
    (call $jstr-cell (local.get $v))))

;; decoded + cleaned, or 0
(func $jfield-clean (param $op i32) (param $oe i32) (param $kp i32) (param $kn i32) (result i32)
  (let [$c (call $jfield-str (local.get $op) (local.get $oe) (local.get $kp) (local.get $kn))]
    ($if (local.get $c)
         (call $clean (c0 (local.get $c)) (c1 (local.get $c)))
         (num 0))))

;; iterate a JSON array of result objects, mapping field names
(func $collect-rows (param $ap i32) (param $ae i32) (param $list i32)
                      (param $tkp i32) (param $tkn i32)
                      (param $ukp i32) (param $ukn i32)
                      (param $skp i32) (param $skn i32)
  (let [$v (call $jfirst (local.get $ap) (local.get $ae)) $ve 0]
    (while (local.get $v)
      (local.set $ve (call $jskip (local.get $v) (local.get $ae)))
      (call $sr-add-cells (local.get $list)
        (call $jfield-clean (local.get $v) (local.get $ve) (local.get $tkp) (local.get $tkn))
        (call $jfield-str (local.get $v) (local.get $ve) (local.get $ukp) (local.get $ukn))
        (call $jfield-clean (local.get $v) (local.get $ve) (local.get $skp) (local.get $skn)))
      (local.set $v (call $jnext (local.get $ve) (local.get $ae))))))

;; ------------------------------------------------------------- providers

(func $ddg-url-resolve (param $hp i32) (param $hn i32) (result i32)
  ;; entity-decode the href, add https: to protocol-relative, follow uddg
  (let [$d (call $buf-new (local.get $hn)) $abs 0 $u 0 $red 0]
    (call $ent-dec (local.get $hp) (local.get $hn) (local.get $d))
    (local.set $abs (call $buf-new (+ (buf-len (local.get $d)) 8)))
    (when (call $starts-with (buf-ptr (local.get $d)) (buf-len (local.get $d)) "//")
      (call $append (local.get $abs) "https:"))
    (call $append (local.get $abs) (buf-ptr (local.get $d)) (buf-len (local.get $d)))
    (local.set $red (call $qparam (buf-ptr (local.get $abs)) (buf-len (local.get $abs)) "uddg"))
    (when (local.get $red)
      (return ($if (call $url-parse (c0 (local.get $red)) (c1 (local.get $red)))
                   (local.get $red)
                   (num 0))))
    ($if (call $url-parse (buf-ptr (local.get $abs)) (buf-len (local.get $abs)))
         (call $cell (buf-ptr (local.get $abs)) (buf-len (local.get $abs)))
         (num 0))))

;; one <a ...> tag scan: does its class contain marker? href span via cell
(func $tag-attr (param $tp i32) (param $tn i32) (param $ap i32) (param $an i32) (result i32)
  ;; find attr="..." inside tag span; cell of the value
  (let [$at (call $find-ci (local.get $tp) (local.get $tn) (local.get $ap) (local.get $an))
        $vs 0 $ve 0]
    (when (neg? (local.get $at)) (return (num 0)))
    (local.set $vs (+ (+ (local.get $at) (local.get $an)) 0))
    ;; expect ="
    (when (not (call $starts-with (+ (local.get $tp) (local.get $vs))
                     (- (local.get $tn) (local.get $vs)) "=\""))
      (return (num 0)))
    (local.set $vs (+ (local.get $vs) 2))
    (local.set $ve (call $find-byte (+ (local.get $tp) (local.get $vs))
                         (- (local.get $tn) (local.get $vs)) (num 34)))
    (when (neg? (local.get $ve)) (return (num 0)))
    (call $cell (+ (local.get $tp) (local.get $vs)) (local.get $ve))))

(func $parse-ddg (param $p i32) (param $n i32) (param $list i32)
  (let [$i 0 $rem 0 $tagend 0 $cls 0 $href 0 $aend 0 $t 0
        $next 0 $win 0 $snip 0 $sgt 0 $send 0 $u 0 $sn 0]
    (while (num 1)
      (local.set $rem (- (local.get $n) (local.get $i)))
      (when (<= (local.get $rem) 0) (return))
      ;; next <a with class containing result__a
      (local.set $t (call $find-ci (+ (local.get $p) (local.get $i)) (local.get $rem) "<a "))
      (when (neg? (local.get $t)) (return))
      (local.set $i (+ (local.get $i) (local.get $t)))
      (local.set $rem (- (local.get $n) (local.get $i)))
      (local.set $tagend (call $find-byte (+ (local.get $p) (local.get $i)) (local.get $rem) (num 62)))
      (when (neg? (local.get $tagend)) (return))
      (local.set $cls (call $tag-attr (+ (local.get $p) (local.get $i)) (local.get $tagend) "class"))
      (if (or (zero? (local.get $cls))
              (neg? (call $find (c0 (local.get $cls)) (c1 (local.get $cls)) "result__a")))
        (then (local.set $i (+ (local.get $i) (inc (local.get $tagend)))))
        (else
          (local.set $href (call $tag-attr (+ (local.get $p) (local.get $i)) (local.get $tagend) "href"))
          ;; title: from '>' to </a>
          (local.set $aend (call $find-ci (+ (+ (local.get $p) (local.get $i)) (inc (local.get $tagend)))
                                 (- (local.get $rem) (inc (local.get $tagend))) "</a>"))
          (when (neg? (local.get $aend))
            (return))
          (when (local.get $href)
            (local.set $u (call $ddg-url-resolve (c0 (local.get $href)) (c1 (local.get $href))))
            (when (local.get $u)
              (local.set $t (call $clean (+ (+ (local.get $p) (local.get $i)) (inc (local.get $tagend)))
                                  (local.get $aend)))
              ;; snippet window: up to 2000 bytes after </a>, ending at the
              ;; next result__a anchor if one begins sooner
              (local.set $win (+ (+ (local.get $i) (inc (local.get $tagend))) (+ (local.get $aend) 4)))
              (local.set $sn (- (local.get $n) (local.get $win)))
              (when (> (local.get $sn) 2000) (local.set $sn (num 2000)))
              (local.set $next (call $find-ci (+ (local.get $p) (local.get $win)) (local.get $sn) "result__a\""))
              (when (>= (local.get $next) 0) (local.set $sn (local.get $next)))
              (local.set $snip (num 0))
              (local.set $send (call $find-ci (+ (local.get $p) (local.get $win)) (local.get $sn) "result__snippet"))
              (when (>= (local.get $send) 0)
                (local.set $sgt (call $find-byte (+ (+ (local.get $p) (local.get $win)) (local.get $send))
                                      (- (local.get $sn) (local.get $send)) (num 62)))
                (when (>= (local.get $sgt) 0)
                  (local.set $send (+ (+ (local.get $send) (local.get $sgt)) 1))
                  (local.set $sgt (call $find-ci (+ (+ (local.get $p) (local.get $win)) (local.get $send))
                                        (- (local.get $sn) (local.get $send)) "</a>"))
                  (when (>= (local.get $sgt) 0)
                    (local.set $snip (call $clean (+ (+ (local.get $p) (local.get $win)) (local.get $send))
                                          (local.get $sgt))))))
              (call $sr-add-cells (local.get $list) (local.get $t) (local.get $u) (local.get $snip))))
          (local.set $i (+ (+ (local.get $i) (inc (local.get $tagend))) (+ (local.get $aend) 4))))))))

(func $search-ddg (param $qp i32) (param $qn i32) (param $out i32) (result i32)
  (let [$body (call $buf-new (num 128)) $rq 0 $resp 0 $b 0 $list 0]
    (call $append (local.get $body) "q=")
    (call $form-enc (local.get $qp) (local.get $qn) (local.get $body))
    (call $append (local.get $body) "&kl=wt-wt")
    (local.set $rq (call $rq-new "POST"))
    (call $rq-url (local.get $rq) "https://html.duckduckgo.com/html/")
    (call $rq-hdr (local.get $rq) "content-type" "application/x-www-form-urlencoded")
    (call $rq-hdr (local.get $rq) "user-agent" (ua))
    (call $rq-hdr (local.get $rq) "accept" "text/html")
    (local.set $resp (call $rq-send (local.get $rq) (buf-ptr (local.get $body)) (buf-len (local.get $body))))
    (when (call $http-guard (local.get $resp) "duckduckgo" (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $list (call $sr-new))
    (call $parse-ddg (c0 (local.get $b)) (c1 (local.get $b)) (local.get $list))
    (local.get $list)))

;; missing SEARCH_API_KEY -> error text; 1 on error
(func $need-key (param $namep i32) (param $namen i32) (param $out i32) (result i32)
  (when (pos? (get-skey-n)) (return (num 0)))
  (call $append (local.get $out) "search provider '")
  (call $append (local.get $out) (local.get $namep) (local.get $namen))
  (call $append (local.get $out) "' requires SEARCH_API_KEY to be configured on the proxy")
  (set-tool-err (num 1))
  (num 1))

(func $search-brave (param $qp i32) (param $qn i32) (param $count i32)
                      (param $fp i32) (param $fn i32) (param $out i32) (result i32)
  (let [$u (call $buf-new (num 256)) $rq 0 $resp 0 $b 0 $list 0 $web 0 $rs 0]
    (when (call $need-key "brave" (local.get $out)) (return (num 0)))
    (call $append (local.get $u) "https://api.search.brave.com/res/v1/web/search?q=")
    (call $form-enc (local.get $qp) (local.get $qn) (local.get $u))
    (call $append (local.get $u) "&count=")
    (call $append-int (local.get $u) (local.get $count))
    (when (pos? (local.get $fn))
      (call $append (local.get $u) "&freshness=")
      ;; day/week/month/year -> pd/pw/pm/py
      (call $append (local.get $u) "p")
      (call $push (local.get $u) (i32.load8_u (local.get $fp))))
    (local.set $rq (call $rq-new "GET"))
    (call $rq-url (local.get $rq) (buf-ptr (local.get $u)) (buf-len (local.get $u)))
    (call $rq-hdr (local.get $rq) "accept" "application/json")
    (call $rq-hdr (local.get $rq) "x-subscription-token" (get-skey-p) (get-skey-n))
    (local.set $resp (call $rq-send (local.get $rq) (num 0) (num 0)))
    (when (call $http-guard (local.get $resp) "brave" (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $list (call $sr-new))
    (local.set $web (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "web"))
    (when (local.get $web)
      (local.set $rs (call $jget (c0 (local.get $web)) (c1 (local.get $web)) "results"))
      (when (local.get $rs)
        (call $collect-rows (c0 (local.get $rs)) (c1 (local.get $rs)) (local.get $list)
          "title" "url" "description")))
    (local.get $list)))

(func $search-tavily (param $qp i32) (param $qn i32) (param $count i32) (param $out i32) (result i32)
  (let [$body (call $buf-new (num 256)) $auth 0 $rq 0 $resp 0 $b 0 $list 0 $rs 0]
    (when (call $need-key "tavily" (local.get $out)) (return (num 0)))
    (call $append (local.get $body) "{\"query\":")
    (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
    (call $append (local.get $body) ",\"max_results\":")
    (call $append-int (local.get $body) (local.get $count))
    (call $append (local.get $body) ",\"search_depth\":\"basic\"}")
    (local.set $auth (call $buf-new (num 64)))
    (call $append (local.get $auth) "Bearer ")
    (call $append (local.get $auth) (get-skey-p) (get-skey-n))
    (local.set $rq (call $rq-new "POST"))
    (call $rq-url (local.get $rq) "https://api.tavily.com/search")
    (call $rq-hdr (local.get $rq) "content-type" "application/json")
    (call $rq-hdr (local.get $rq) "authorization" (buf-ptr (local.get $auth)) (buf-len (local.get $auth)))
    (local.set $resp (call $rq-send (local.get $rq) (buf-ptr (local.get $body)) (buf-len (local.get $body))))
    (when (call $http-guard (local.get $resp) "tavily" (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $list (call $sr-new))
    (local.set $rs (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "results"))
    (when (local.get $rs)
      (call $collect-rows (c0 (local.get $rs)) (c1 (local.get $rs)) (local.get $list)
        "title" "url" "content"))
    (local.get $list)))

(func $search-exa (param $qp i32) (param $qn i32) (param $count i32) (param $out i32) (result i32)
  (let [$body (call $buf-new (num 256)) $rq 0 $resp 0 $b 0 $list 0 $rs 0]
    (when (call $need-key "exa" (local.get $out)) (return (num 0)))
    (call $append (local.get $body) "{\"query\":")
    (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
    (call $append (local.get $body) ",\"numResults\":")
    (call $append-int (local.get $body) (local.get $count))
    (call $append (local.get $body) ",\"contents\":{\"text\":{\"maxCharacters\":600}}}")
    (local.set $rq (call $rq-new "POST"))
    (call $rq-url (local.get $rq) "https://api.exa.ai/search")
    (call $rq-hdr (local.get $rq) "content-type" "application/json")
    (call $rq-hdr (local.get $rq) "x-api-key" (get-skey-p) (get-skey-n))
    (local.set $resp (call $rq-send (local.get $rq) (buf-ptr (local.get $body)) (buf-len (local.get $body))))
    (when (call $http-guard (local.get $resp) "exa" (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $list (call $sr-new))
    (local.set $rs (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "results"))
    (when (local.get $rs)
      (call $collect-rows (c0 (local.get $rs)) (c1 (local.get $rs)) (local.get $list)
        "title" "url" "text"))
    (local.get $list)))

(func $search-serper (param $qp i32) (param $qn i32) (param $count i32) (param $out i32) (result i32)
  (let [$body (call $buf-new (num 256)) $rq 0 $resp 0 $b 0 $list 0 $rs 0]
    (when (call $need-key "serper" (local.get $out)) (return (num 0)))
    (call $append (local.get $body) "{\"q\":")
    (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
    (call $append (local.get $body) ",\"num\":")
    (call $append-int (local.get $body) (local.get $count))
    (call $append (local.get $body) "}")
    (local.set $rq (call $rq-new "POST"))
    (call $rq-url (local.get $rq) "https://google.serper.dev/search")
    (call $rq-hdr (local.get $rq) "content-type" "application/json")
    (call $rq-hdr (local.get $rq) "x-api-key" (get-skey-p) (get-skey-n))
    (local.set $resp (call $rq-send (local.get $rq) (buf-ptr (local.get $body)) (buf-len (local.get $body))))
    (when (call $http-guard (local.get $resp) "serper" (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $list (call $sr-new))
    (local.set $rs (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "organic"))
    (when (local.get $rs)
      (call $collect-rows (c0 (local.get $rs)) (c1 (local.get $rs)) (local.get $list)
        "title" "link" "snippet"))
    (local.get $list)))

;; ------------------------------------------- gateway server-tool search

;; strip ```json fences; cell of the inner span
(func $strip-fences (param $p i32) (param $n i32) (result i32)
  (let [$t (call $trim (local.get $p) (local.get $n)) $a 0 $s 0 $e 0]
    (local.set $p (c0 (local.get $t)))
    (local.set $n (c1 (local.get $t)))
    (local.set $a (call $find (local.get $p) (local.get $n) "```"))
    (when (neg? (local.get $a)) (return (call $cell (local.get $p) (local.get $n))))
    (local.set $s (+ (local.get $a) 3))
    (when (call $starts-with-ci (+ (local.get $p) (local.get $s)) (- (local.get $n) (local.get $s)) "json")
      (local.set $s (+ (local.get $s) 4)))
    (local.set $e (call $find (+ (local.get $p) (local.get $s)) (- (local.get $n) (local.get $s)) "```"))
    (when (neg? (local.get $e)) (return (call $cell (local.get $p) (local.get $n))))
    (call $trim (+ (local.get $p) (local.get $s)) (local.get $e))))

;; gateway chat-completions URL: FX_GATEWAY_BASE_URL override or default
(func $gw-url (result i32)
  (let [$b (call $buf-new (num 96))]
    (if (pos? (get-gwbase-n))
      (then (call $append (local.get $b) (get-gwbase-p) (get-gwbase-n)))
      (else (call $append (local.get $b) "https://ai-gateway.vercel.sh")))
    (call $append (local.get $b) "/v1/chat/completions")
    (call $cell (buf-ptr (local.get $b)) (buf-len (local.get $b)))))

;; POST a chat-completions body with the resolved gateway key; resp ptr
(func $gw-post (param $bp i32) (param $bn i32) (result i32)
  (let [$auth (call $buf-new (num 64)) $u (call $gw-url) $rq 0 $resp 0 $st 0]
    (call $append (local.get $auth) "Bearer ")
    (call $append (local.get $auth) (get-gwkey-p) (get-gwkey-n))
    (local.set $rq (call $rq-new "POST"))
    (call $rq-url (local.get $rq) (c0 (local.get $u)) (c1 (local.get $u)))
    (call $rq-hdr (local.get $rq) "content-type" "application/json")
    (call $rq-hdr (local.get $rq) "authorization" (buf-ptr (local.get $auth)) (buf-len (local.get $auth)))
    (local.set $resp (call $rq-send (local.get $rq) (local.get $bp) (local.get $bn)))
    (local.set $st (call $resp-status (local.get $resp)))
    (when (or (= (local.get $st) 401) (= (local.get $st) 403))
      (set-authfails (inc (get-authfails))))
    (set-modelreqs (inc (get-modelreqs)))
    (local.get $resp)))

;; tool 5 perplexity, 6 parallel, 7 tako
(func $gw-tool-name (param $tool i32) (param $b i32)
  (cond
    (= (local.get $tool) 5) (splice (call $append (local.get $b) "perplexity") (num 0))
    (= (local.get $tool) 6) (splice (call $append (local.get $b) "parallel") (num 0))
    :else (splice (call $append (local.get $b) "tako") (num 0)))
  (drop))

(func $search-gateway (param $tool i32) (param $qp i32) (param $qn i32) (param $count i32)
                        (param $sp i32) (param $sn i32) (param $fp i32) (param $fn i32)
                        (param $out i32) (result i32)
  (let [$name (call $buf-new (num 16)) $body 0 $resp 0 $b 0 $ch 0 $m 0 $msg 0 $me 0
        $pm 0 $gw 0 $tc 0 $ex 0 $content 0 $inner 0 $rows 0 $list 0 $key 0]
    (call $gw-tool-name (local.get $tool) (local.get $name))
    (when (zero? (get-gwkey-n))
      (call $append (local.get $out) "search provider '")
      (call $append (local.get $out) (buf-ptr (local.get $name)) (buf-len (local.get $name)))
      (call $append (local.get $out) "' bills through Vercel AI Gateway; send an AI Gateway key as `Authorization: Bearer <key>`")
      (set-tool-err (num 1))
      (return (num 0)))
    (local.set $body (call $buf-new (num 512)))
    (call $append (local.get $body) "{\"model\":\"alibaba/qwen3.7-flash\",\"messages\":[")
    (call $append (local.get $body) "{\"role\":\"system\",\"content\":\"Reply with JSON only of the form {\\\"results\\\":[{\\\"title\\\":\\\"\\\",\\\"url\\\":\\\"\\\",\\\"snippet\\\":\\\"\\\"}]}. One-sentence snippets. Include every search hit. No markdown fences.\"},")
    (call $append (local.get $body) "{\"role\":\"user\",\"content\":")
    (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
    (call $append (local.get $body) "}],\"tools\":[{\"type\":\"vercel:")
    (call $append (local.get $body) (buf-ptr (local.get $name)) (buf-len (local.get $name)))
    (call $append (local.get $body) "_search\",\"config\":{")
    (if (= (local.get $tool) 6)
      (then
        ;; parallel: objective / max_results / source_policy
        (call $append (local.get $body) "\"objective\":")
        (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
        (call $append (local.get $body) ",\"max_results\":")
        (call $append-int (local.get $body) (local.get $count))
        (when (pos? (local.get $sn))
          (call $append (local.get $body) ",\"source_policy\":{\"include_domains\":[")
          (call $jqstr (local.get $body) (local.get $sp) (local.get $sn))
          (call $append (local.get $body) "]}")))
      (else
        (call $append (local.get $body) "\"query\":")
        (call $jqstr (local.get $body) (local.get $qp) (local.get $qn))
        (call $append (local.get $body) ",\"max_results\":")
        (call $append-int (local.get $body) (local.get $count))
        (when (pos? (local.get $sn))
          (call $append (local.get $body) ",\"search_domain_filter\":[")
          (call $jqstr (local.get $body) (local.get $sp) (local.get $sn))
          (call $append (local.get $body) "]"))
        (when (and (= (local.get $tool) 5) (pos? (local.get $fn))
                   )
          (call $append (local.get $body) ",\"search_recency_filter\":")
          (call $jqstr (local.get $body) (local.get $fp) (local.get $fn)))))
    (call $append (local.get $body) "}}],\"tool_choice\":\"required\",\"max_tokens\":1200}")
    (local.set $resp (call $gw-post (buf-ptr (local.get $body)) (buf-len (local.get $body))))
    (when (call $http-guard (local.get $resp) (buf-ptr (local.get $name)) (buf-len (local.get $name)) (local.get $out))
      (return (num 0)))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    ;; choices[0].message
    (local.set $ch (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "choices"))
    (local.set $msg (num 0))
    (when (local.get $ch)
      (local.set $m (call $jfirst (c0 (local.get $ch)) (c1 (local.get $ch))))
      (when (local.get $m)
        (local.set $me (call $jskip (local.get $m) (c1 (local.get $ch))))
        (local.set $msg (call $jget (local.get $m) (local.get $me) "message"))))
    (when (zero? (local.get $msg))
      (call $append (local.get $out) "AI Gateway search returned unparseable results")
      (set-tool-err (num 1))
      (return (num 0)))
    ;; provider_metadata.gateway.gatewayToolCalls["<tool>_search"] >= 1
    (local.set $ex (num 0))
    (local.set $pm (call $jget (c0 (local.get $msg)) (c1 (local.get $msg)) "provider_metadata"))
    (when (local.get $pm)
      (local.set $gw (call $jget (c0 (local.get $pm)) (c1 (local.get $pm)) "gateway"))
      (when (local.get $gw)
        (local.set $tc (call $jget (c0 (local.get $gw)) (c1 (local.get $gw)) "gatewayToolCalls"))
        (when (local.get $tc)
          (call $append (local.get $name) "_search")
          (local.set $key (call $jget (c0 (local.get $tc)) (c1 (local.get $tc))
                                (buf-ptr (local.get $name)) (buf-len (local.get $name))))
          (when (local.get $key)
            (local.set $ex (c1 (call $jint (c0 (local.get $key)) (c1 (local.get $key)))))))))
    (when (< (local.get $ex) 1)
      (call $gw-tool-name (local.get $tool) (local.get $out))
      (call $append (local.get $out) " search was not executed by the AI Gateway")
      (set-tool-err (num 1))
      (return (num 0)))
    ;; content -> strip fences -> {results:[...]} or [...]
    (local.set $content (call $jget (c0 (local.get $msg)) (c1 (local.get $msg)) "content"))
    (when (or (zero? (local.get $content))
              (not (call $jstring? (c0 (local.get $content)))))
      (call $append (local.get $out) "AI Gateway search returned unparseable results")
      (set-tool-err (num 1))
      (return (num 0)))
    (local.set $content (call $jstr-cell (local.get $content)))
    (local.set $inner (call $strip-fences (c0 (local.get $content)) (c1 (local.get $content))))
    (local.set $rows (num 0))
    (cond
      (zero? (c1 (local.get $inner))) (num 0)
      (call $jarray? (c0 (local.get $inner)))
        (splice (local.set $rows (call $cell (c0 (local.get $inner))
                                       (+ (c0 (local.get $inner)) (c1 (local.get $inner)))))
                (num 0))
      (call $jobject? (c0 (local.get $inner)))
        (splice (local.set $rows (call $jget (c0 (local.get $inner))
                                       (+ (c0 (local.get $inner)) (c1 (local.get $inner)))
                                       "results"))
                (num 0))
      :else (num 0))
    (drop)
    (when (or (zero? (local.get $rows))
              (not (call $jarray? (c0 (local.get $rows)))))
      (if (call $jobject? (c0 (local.get $inner)))
        (then (call $append (local.get $out) "AI Gateway search returned no result list"))
        (else (call $append (local.get $out) "AI Gateway search returned unparseable results")))
      (set-tool-err (num 1))
      (return (num 0)))
    (local.set $list (call $sr-new))
    (call $collect-rows (c0 (local.get $rows)) (c1 (local.get $rows)) (local.get $list)
      "title" "url" "snippet")
    (local.get $list)))

;; ------------------------------------------------------------ the entry

;; runs the configured provider; writes rendered output (or an error
;; message) to out; sets tool-err and tool-count
(func $search (param $qp i32) (param $qn i32) (param $count i32)
                (param $sp i32) (param $sn i32) (param $fp i32) (param $fn i32)
                (param $out i32)
  (let [$q (call $buf-new (num 128)) $list 0 $prov (get-provider)]
    (set-tool-err (num 0))
    (set-tool-count (num 0))
    ;; non-gateway providers get site: folded into the query
    (call $append (local.get $q) (local.get $qp) (local.get $qn))
    (when (and (pos? (local.get $sn)) (< (local.get $prov) 5))
      (call $append (local.get $q) " site:")
      (call $append (local.get $q) (local.get $sp) (local.get $sn)))
    (local.set $list
      (cond
        (= (local.get $prov) 0)
          (call $search-ddg (buf-ptr (local.get $q)) (buf-len (local.get $q)) (local.get $out))
        (= (local.get $prov) 1)
          (call $search-brave (buf-ptr (local.get $q)) (buf-len (local.get $q)) (local.get $count)
                (local.get $fp) (local.get $fn) (local.get $out))
        (= (local.get $prov) 2)
          (call $search-tavily (buf-ptr (local.get $q)) (buf-len (local.get $q)) (local.get $count) (local.get $out))
        (= (local.get $prov) 3)
          (call $search-exa (buf-ptr (local.get $q)) (buf-len (local.get $q)) (local.get $count) (local.get $out))
        (= (local.get $prov) 4)
          (call $search-serper (buf-ptr (local.get $q)) (buf-len (local.get $q)) (local.get $count) (local.get $out))
        :else
          (call $search-gateway (local.get $prov) (local.get $qp) (local.get $qn) (local.get $count)
                (local.get $sp) (local.get $sn) (local.get $fp) (local.get $fn) (local.get $out))))
    (when (get-tool-err) (return))
    (when (zero? (local.get $list)) (return))
    (if (zero? (sr-count (local.get $list)))
      (then
        (call $append (local.get $out) "no results for: ")
        (call $append (local.get $out) (local.get $qp) (local.get $qn))
        (set-tool-count (num 0)))
      (else
        (call $render-results (local.get $list) (local.get $qp) (local.get $qn)
              (local.get $count) (local.get $out))))))
