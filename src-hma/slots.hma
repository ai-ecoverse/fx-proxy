;; slots.hma — request-scoped registers in page 1 (65600..), macros only.
;; Every slot is one i32; strings are (ptr len) slot pairs. worker.hma
;; fills them from the request frame; everything downstream reads them.

(defmacro get-method-p () `(i32.load (i32.const 65600)))
(defmacro set-method-p (v) `(i32.store (i32.const 65600) (num ,v)))
