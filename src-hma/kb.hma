;; kb.hma — the AEM knowledge base tools of src/tools/knowledgebase.ts:
;; sitemap listing (with nested sitemaps and the query-index merge) and
;; markdown page retrieval.

;; GitHub-style name: ^[A-Za-z0-9]([A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$, no "--"
(func $name-ok? (param $p i32) (param $n i32) (result i32)
  (let [$i 0 $c 0]
    (when (or (zero? (local.get $n)) (> (local.get $n) 64)) (return (num 0)))
    (when (>= (call $find (local.get $p) (local.get $n) "--") 0) (return (num 0)))
    (while (< (local.get $i) (local.get $n))
      (local.set $c (i32.load8_u (+ (local.get $p) (local.get $i))))
      (if (or (zero? (local.get $i)) (= (local.get $i) (dec (local.get $n))))
        (then
          (when (not (or (call $alpha? (local.get $c)) (call $digit? (local.get $c))))
            (return (num 0))))
        (else
          (when (not (or (call $alpha? (local.get $c))
                         (or (call $digit? (local.get $c))
                             (or (= (local.get $c) 46)
                                 (or (= (local.get $c) 95) (= (local.get $c) 45))))))
            (return (num 0)))))
      (local.set $i (inc (local.get $i))))
    (num 1)))

;; https://<ref>--<repo>--<org>.aem.live into a fresh buffer; sets slots
(func $kb-build-origin
  (let [$b (call $buf-new (num 96))]
    (call $append (local.get $b) "https://")
    (call $append (local.get $b) (get-kb-ref-p) (get-kb-ref-n))
    (call $append (local.get $b) "--")
    (call $append (local.get $b) (get-kb-repo-p) (get-kb-repo-n))
    (call $append (local.get $b) "--")
    (call $append (local.get $b) (get-kb-org-p) (get-kb-org-n))
    (call $append (local.get $b) ".aem.live")
    (set-kb-origin-p (buf-ptr (local.get $b)))
    (set-kb-origin-n (buf-len (local.get $b)))))

;; org/repo@ref
(func $kb-label (param $b i32)
  (call $append (local.get $b) (get-kb-org-p) (get-kb-org-n))
  (call $append (local.get $b) "/")
  (call $append (local.get $b) (get-kb-repo-p) (get-kb-repo-n))
  (call $append (local.get $b) "@")
  (call $append (local.get $b) (get-kb-ref-p) (get-kb-ref-n)))

;; canonical site path; writes the error to err and returns 0 on refusal
(func $canon-path (param $p i32) (param $n i32) (param $err i32) (result i32)
  (let [$t (call $trim (local.get $p) (local.get $n)) $st 0 $b 0 $i 0 $c 0 $cut 0 $seg 0]
    (local.set $p (c0 (local.get $t)))
    (local.set $n (c1 (local.get $t)))
    (when (zero? (local.get $n))
      (call $append (local.get $err) "path must not be empty")
      (return (num 0)))
    ;; a full URL contributes only its pathname
    (when (or (call $starts-with-ci (local.get $p) (local.get $n) "http://")
              (call $starts-with-ci (local.get $p) (local.get $n) "https://"))
      (local.set $st (call $url-parse (local.get $p) (local.get $n)))
      (when (zero? (local.get $st))
        (call $append (local.get $err) "not a valid URL: ")
        (call $append (local.get $err) (local.get $p) (local.get $n))
        (return (num 0)))
      (local.set $p (+ (local.get $p) (i32.load (+ (local.get $st) 8))))
      (local.set $n (- (local.get $n) (i32.load (+ (local.get $st) 8)))))
    ;; cut at ? or #
    (local.set $cut (call $find-byte (local.get $p) (local.get $n) (num 63)))
    (when (>= (local.get $cut) 0) (local.set $n (local.get $cut)))
    (local.set $cut (call $find-byte (local.get $p) (local.get $n) (num 35)))
    (when (>= (local.get $cut) 0) (local.set $n (local.get $cut)))
    ;; build: backslashes to /, leading /, collapse runs of /
    (local.set $b (call $buf-new (+ (local.get $n) 2)))
    (call $push (local.get $b) (num 47))
    (while (< (local.get $i) (local.get $n))
      (local.set $c (i32.load8_u (+ (local.get $p) (local.get $i))))
      (when (= (local.get $c) 92) (local.set $c (num 47)))
      (when (not (and (= (local.get $c) 47)
                      (= (i32.load8_u (dec (buf-end (local.get $b)))) 47)))
        (call $push (local.get $b) (local.get $c)))
      (local.set $i (inc (local.get $i))))
    ;; refusals: NUL, a ".." segment, literal %2e%2e
    (local.set $seg (num 0))
    (when (or (>= (call $find-byte (buf-ptr (local.get $b)) (buf-len (local.get $b)) (num 0)) 0)
              (>= (call $find (buf-ptr (local.get $b)) (buf-len (local.get $b)) "%2e%2e") 0))
      (local.set $seg (num 1)))
    ;; ".." as a whole segment: "/../", or trailing "/.."
    (when (>= (call $find (buf-ptr (local.get $b)) (buf-len (local.get $b)) "/../") 0)
      (local.set $seg (num 1)))
    (when (call $ends-with (buf-ptr (local.get $b)) (buf-len (local.get $b)) "/..")
      (local.set $seg (num 1)))
    (when (local.get $seg)
      (call $append (local.get $err) "refusing a path that escapes the site: ")
      (call $append (local.get $err) (local.get $p) (local.get $n))
      (return (num 0)))
    ;; strip .md / .html, then trailing slashes (keep the root /)
    (when (call $ends-with (buf-ptr (local.get $b)) (buf-len (local.get $b)) ".md")
      (i32.store (+ (local.get $b) 4) (- (buf-len (local.get $b)) 3)))
    (when (call $ends-with (buf-ptr (local.get $b)) (buf-len (local.get $b)) ".html")
      (i32.store (+ (local.get $b) 4) (- (buf-len (local.get $b)) 5)))
    (while (and (> (buf-len (local.get $b)) 1)
                (= (i32.load8_u (dec (buf-end (local.get $b)))) 47))
      (i32.store (+ (local.get $b) 4) (dec (buf-len (local.get $b)))))
    (call $cell (buf-ptr (local.get $b)) (buf-len (local.get $b)))))

;; ---------------------------------------------------------- sitemap parse

;; find next <loc>/<ns:loc> content within span from i; 12-byte record
;; (contentStart contentEnd nextIndex) or 0
(func $xml-loc (param $p i32) (param $n i32) (param $from i32) (result i32)
  (let [$at 0 $gt 0 $s 0 $e 0 $r 0 $tagp 0 $tagn 0]
    (while (num 1)
      (local.set $at (call $find-ci (+ (local.get $p) (local.get $from))
                           (- (local.get $n) (local.get $from)) "<loc"))
      ;; also allow a prefixed tag by searching ":loc" starts — keep it
      ;; simple: aem sitemaps use plain <loc>
      (when (neg? (local.get $at)) (return (num 0)))
      (local.set $at (+ (local.get $from) (local.get $at)))
      (local.set $gt (call $find-byte (+ (local.get $p) (local.get $at))
                           (- (local.get $n) (local.get $at)) (num 62)))
      (when (neg? (local.get $gt)) (return (num 0)))
      (local.set $s (+ (+ (local.get $at) (local.get $gt)) 1))
      (local.set $e (call $find-ci (+ (local.get $p) (local.get $s))
                          (- (local.get $n) (local.get $s)) "</loc"))
      (when (neg? (local.get $e)) (return (num 0)))
      (local.set $r (call $alloc (num 12)))
      (i32.store (local.get $r) (+ (local.get $p) (local.get $s)))
      (i32.store (+ (local.get $r) 4) (+ (+ (local.get $p) (local.get $s)) (local.get $e)))
      (i32.store (+ (local.get $r) 8) (+ (+ (local.get $s) (local.get $e)) 5))
      (return (local.get $r)))
    (num 0)))

;; xml text content: strip CDATA wrapper, decode the five entities, trim
(func $xml-text (param $p i32) (param $e i32) (result i32)
  (let [$n (- (local.get $e) (local.get $p)) $b (call $buf-new (num 64)) $i 0 $c 0]
    (when (and (call $starts-with (local.get $p) (local.get $n) "<![CDATA[")
               (call $ends-with (local.get $p) (local.get $n) "]]>"))
      (local.set $p (+ (local.get $p) 9))
      (local.set $n (- (local.get $n) 12)))
    (while (< (local.get $i) (local.get $n))
      (local.set $c (i32.load8_u (+ (local.get $p) (local.get $i))))
      (if (= (local.get $c) 38)
        (then
          (cond
            (call $starts-with (+ (local.get $p) (local.get $i)) (- (local.get $n) (local.get $i)) "&amp;")
              (splice (call $append (local.get $b) "&") (local.set $i (+ (local.get $i) 5)) (num 0))
            (call $starts-with (+ (local.get $p) (local.get $i)) (- (local.get $n) (local.get $i)) "&lt;")
              (splice (call $append (local.get $b) "<") (local.set $i (+ (local.get $i) 4)) (num 0))
            (call $starts-with (+ (local.get $p) (local.get $i)) (- (local.get $n) (local.get $i)) "&gt;")
              (splice (call $append (local.get $b) ">") (local.set $i (+ (local.get $i) 4)) (num 0))
            (call $starts-with (+ (local.get $p) (local.get $i)) (- (local.get $n) (local.get $i)) "&quot;")
              (splice (call $append (local.get $b) "\"") (local.set $i (+ (local.get $i) 6)) (num 0))
            (call $starts-with (+ (local.get $p) (local.get $i)) (- (local.get $n) (local.get $i)) "&apos;")
              (splice (call $append (local.get $b) "'") (local.set $i (+ (local.get $i) 6)) (num 0))
            :else
              (splice (call $push (local.get $b) (local.get $c)) (local.set $i (inc (local.get $i))) (num 0)))
          (drop))
        (else
          (call $push (local.get $b) (local.get $c))
          (local.set $i (inc (local.get $i))))))
    (call $trim (buf-ptr (local.get $b)) (buf-len (local.get $b)))))

;; page records: 32 bytes [pathP pathN lmP lmN titleP titleN descP descN]
(defmacro pg-count (list) `(i32.div_u (buf-len (num ,list)) (i32.const 32)))
(defmacro pg-at (list i) `(+ (buf-ptr (num ,list)) (i32.mul (num ,i) (i32.const 32))))

(func $pg-add (param $list i32) (param $pp i32) (param $pn i32) (param $lp i32) (param $ln i32)
  (let [$i 0 $r 0]
    ;; dedupe by path
    (while (< (local.get $i) (pg-count (local.get $list)))
      (local.set $r (pg-at (local.get $list) (local.get $i)))
      (when (call $str-eq (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))
                  (local.get $pp) (local.get $pn))
        (return))
      (local.set $i (inc (local.get $i))))
    (call $buf-reserve (local.get $list) (num 32))
    (local.set $r (buf-end (local.get $list)))
    (memory.fill (local.get $r) (num 0) (num 32))
    (i32.store (local.get $r) (local.get $pp))
    (i32.store (+ (local.get $r) 4) (local.get $pn))
    (i32.store (+ (local.get $r) 8) (local.get $lp))
    (i32.store (+ (local.get $r) 12) (local.get $ln))
    (i32.store (+ (local.get $list) 4) (+ (buf-len (local.get $list)) 32))))

;; GET url with the kb accept header; response ptr
(func $kb-fetch (param $up i32) (param $un i32) (param $acceptp i32) (param $acceptn i32) (result i32)
  (let [$rq (call $rq-new "GET")]
    (call $rq-url (local.get $rq) (local.get $up) (local.get $un))
    (call $rq-hdr (local.get $rq) "user-agent" (ua))
    (call $rq-hdr (local.get $rq) "accept" (local.get $acceptp) (local.get $acceptn))
    (call $rq-send (local.get $rq) (num 0) (num 0))))

;; loc -> canonical path cell or 0; relative locs resolve against origin
(func $kb-path-of-loc (param $lp i32) (param $ln i32) (result i32)
  (let [$st 0 $err (call $buf-new (num 16)) $abs 0]
    (if (or (call $starts-with-ci (local.get $lp) (local.get $ln) "http://")
            (call $starts-with-ci (local.get $lp) (local.get $ln) "https://"))
      (then
        (local.set $st (call $url-parse (local.get $lp) (local.get $ln)))
        (when (zero? (local.get $st)) (return (num 0)))
        (return (call $canon-path (+ (local.get $lp) (i32.load (+ (local.get $st) 8)))
                      (- (local.get $ln) (i32.load (+ (local.get $st) 8)))
                      (local.get $err))))
      (else
        ;; treat as a path
        (return (call $canon-path (local.get $lp) (local.get $ln) (local.get $err)))))
    (num 0)))

;; load sitemap pages into list; writes error text + tool-err on failure
(func $kb-load-sitemap (param $list i32) (param $out i32)
  (let [$queue (call $buf-new (num 64)) $qhead 0 $seen 0 $u 0 $resp 0 $b 0
        $r 0 $from 0 $loc 0 $isidx 0 $blk 0 $lm 0 $lmrec 0 $lme 0
        $path 0 $urlb (call $buf-new (num 96)) $st 0]
    ;; queue of url cells (8 bytes each)
    (call $append (local.get $urlb) (get-kb-origin-p) (get-kb-origin-n))
    (call $append (local.get $urlb) "/sitemap.xml")
    (call $append-u32 (local.get $queue) (call $cell (buf-ptr (local.get $urlb)) (buf-len (local.get $urlb))))
    (while (and (< (local.get $qhead) (i32.div_u (buf-len (local.get $queue)) (num 4)))
                (< (local.get $seen) 8))
      (local.set $u (i32.load (+ (buf-ptr (local.get $queue)) (* 4 (local.get $qhead)))))
      (local.set $qhead (inc (local.get $qhead)))
      (local.set $seen (inc (local.get $seen)))
      (local.set $resp (call $kb-fetch (c0 (local.get $u)) (c1 (local.get $u))
                             "application/xml, text/xml, text/plain;q=0.8"))
      (local.set $st (call $resp-status (local.get $resp)))
      (when (or (< (local.get $st) 200) (>= (local.get $st) 300))
        (call $append (local.get $out) "sitemap fetch failed with HTTP ")
        (call $append-int (local.get $out) (local.get $st))
        (set-tool-err (num 1))
        (return))
      (local.set $b (call $resp-body (local.get $resp)))
      (when (> (c1 (local.get $b)) 5000000)
        (call $append (local.get $out) "sitemap is larger than 5000000 bytes")
        (set-tool-err (num 1))
        (return))
      (local.set $isidx (>= (call $find-ci (c0 (local.get $b)) (c1 (local.get $b)) "<sitemapindex") 0))
      (if (local.get $isidx)
        (then
          ;; nested sitemaps: every <loc> that is an .xml url we may fetch
          (local.set $from (num 0))
          (while (local.tee $r (call $xml-loc (c0 (local.get $b)) (c1 (local.get $b)) (local.get $from)))
            (local.set $from (i32.load (+ (local.get $r) 8)))
            (local.set $loc (call $xml-text (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))))
            (when (and (pos? (c1 (local.get $loc)))
                       (< (+ (i32.div_u (buf-len (local.get $queue)) (num 4))) 8))
              (local.set $st (call $url-parse (c0 (local.get $loc)) (c1 (local.get $loc))))
              (when (and (local.get $st)
                         (and (not (call $host-blocked? (i32.load (local.get $st))
                                         (i32.load (+ (local.get $st) 4))))
                              (call $ends-with-ci (c0 (local.get $loc)) (c1 (local.get $loc)) ".xml")))
                (call $append-u32 (local.get $queue) (local.get $loc))))))
        (else
          ;; url set: split on "<url" blocks
          (local.set $from (num 0))
          (while (>= (local.tee $blk (call $find-ci (+ (c0 (local.get $b)) (local.get $from))
                                          (- (c1 (local.get $b)) (local.get $from)) "<url")) 0)
            (local.set $from (+ (+ (local.get $from) (local.get $blk)) 4))
            ;; block extends to the next <url or the end
            (local.set $blk (call $find-ci (+ (c0 (local.get $b)) (local.get $from))
                                  (- (c1 (local.get $b)) (local.get $from)) "</url>"))
            (when (neg? (local.get $blk))
              (local.set $blk (- (c1 (local.get $b)) (local.get $from))))
            ;; loc + lastmod inside the block
            (local.set $r (call $xml-loc (+ (c0 (local.get $b)) (local.get $from)) (local.get $blk) (num 0)))
            (when (local.get $r)
              (local.set $loc (call $xml-text (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))))
              (local.set $path (call $kb-path-of-loc (c0 (local.get $loc)) (c1 (local.get $loc))))
              (when (local.get $path)
                (local.set $lm (num 0))
                (local.set $lmrec (call $find-ci (+ (c0 (local.get $b)) (local.get $from)) (local.get $blk) "<lastmod>"))
                (when (>= (local.get $lmrec) 0)
                  (local.set $lme (call $find-ci
                                    (+ (+ (c0 (local.get $b)) (local.get $from)) (+ (local.get $lmrec) 9))
                                    (- (local.get $blk) (+ (local.get $lmrec) 9)) "</lastmod"))
                  (when (>= (local.get $lme) 0)
                    (local.set $lm (call $xml-text
                                     (+ (+ (c0 (local.get $b)) (local.get $from)) (+ (local.get $lmrec) 9))
                                     (+ (+ (+ (c0 (local.get $b)) (local.get $from)) (+ (local.get $lmrec) 9))
                                        (local.get $lme))))))
                (call $pg-add (local.get $list)
                  (c0 (local.get $path)) (c1 (local.get $path))
                  ($if (local.get $lm) (c0 (local.get $lm)) (num 0))
                  ($if (local.get $lm) (c1 (local.get $lm)) (num 0)))))
            (local.set $from (+ (local.get $from) (local.get $blk)))))))))

(func $ends-with-ci (param $p i32) (param $n i32) (param $sp i32) (param $sn i32) (result i32)
  ($if (< (local.get $n) (local.get $sn))
       (num 0)
       (call $memeq-ci (+ (local.get $p) (- (local.get $n) (local.get $sn)))
             (local.get $sp) (local.get $sn))))

;; query-index merge: title/description for known paths
(func $kb-merge-index (param $list i32)
  (let [$urlb (call $buf-new (num 96)) $resp 0 $b 0 $data 0 $row 0 $rowe 0
        $pathc 0 $canon 0 $err (call $buf-new (num 8)) $i 0 $r 0 $t 0 $d 0]
    (call $append (local.get $urlb) (get-kb-origin-p) (get-kb-origin-n))
    (call $append (local.get $urlb) "/query-index.json")
    (local.set $resp (call $kb-fetch (buf-ptr (local.get $urlb)) (buf-len (local.get $urlb))
                           "application/json"))
    (when (or (< (call $resp-status (local.get $resp)) 200)
              (>= (call $resp-status (local.get $resp)) 300))
      (return))
    (local.set $b (call $as-span (call $resp-body (local.get $resp))))
    (local.set $data (call $jget (c0 (local.get $b)) (c1 (local.get $b)) "data"))
    (when (zero? (local.get $data)) (return))
    (local.set $row (call $jfirst (c0 (local.get $data)) (c1 (local.get $data))))
    (while (local.get $row)
      (local.set $rowe (call $jskip (local.get $row) (c1 (local.get $data))))
      (local.set $pathc (call $jfield-str (local.get $row) (local.get $rowe) "path"))
      (when (and (local.get $pathc) (pos? (c1 (local.get $pathc))))
        (local.set $canon (call $canon-path (c0 (local.get $pathc)) (c1 (local.get $pathc)) (local.get $err)))
        (when (local.get $canon)
          ;; find the page and graft title/description
          (local.set $i (num 0))
          (while (< (local.get $i) (pg-count (local.get $list)))
            (local.set $r (pg-at (local.get $list) (local.get $i)))
            (when (call $str-eq (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))
                        (c0 (local.get $canon)) (c1 (local.get $canon)))
              (local.set $t (call $jfield-str (local.get $row) (local.get $rowe) "title"))
              (local.set $d (call $jfield-str (local.get $row) (local.get $rowe) "description"))
              (when (and (local.get $t) (pos? (c1 (local.get $t))))
                (i32.store (+ (local.get $r) 16) (c0 (local.get $t)))
                (i32.store (+ (local.get $r) 20) (c1 (local.get $t))))
              (when (local.get $d)
                (i32.store (+ (local.get $r) 24) (c0 (local.get $d)))
                (i32.store (+ (local.get $r) 28) (c1 (local.get $d)))))
            (local.set $i (inc (local.get $i))))))
      (local.set $row (call $jnext (local.get $rowe) (c1 (local.get $data)))))))

;; contains, case-insensitive against a lowercased needle
(func $contains-ci (param $p i32) (param $n i32) (param $np i32) (param $nn i32) (result i32)
  (>= (call $find-ci (local.get $p) (local.get $n) (local.get $np) (local.get $nn)) 0))

;; knowledgebase_list: renders into out; sets tool-err/tool-count
(func $kb-list (param $prefp i32) (param $prefn i32) (param $qp i32) (param $qn i32)
                 (param $limit i32) (param $out i32)
  (let [$list (call $buf-new (num 1024)) $pref 0 $err (call $buf-new (num 64))
        $i 0 $r 0 $keep 0 $total 0 $shown 0 $rendered 0 $hay 0]
    (call $kb-load-sitemap (local.get $list) (local.get $out))
    (when (get-tool-err) (return))
    (call $kb-merge-index (local.get $list))
    ;; normalize the prefix
    (local.set $pref (num 0))
    (when (pos? (local.get $prefn))
      (local.set $pref (call $canon-path (local.get $prefp) (local.get $prefn) (local.get $err))))
    ;; filter in place: mark kept records by compacting
    (local.set $i (num 0))
    (local.set $keep (num 0))
    (while (< (local.get $i) (pg-count (local.get $list)))
      (local.set $r (pg-at (local.get $list) (local.get $i)))
      (local.set $rendered (num 1))
      ;; prefix filter: "/" keeps everything
      (when (and (local.get $pref) (> (c1 (local.get $pref)) 1))
        (when (not (call $str-eq (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))
                         (c0 (local.get $pref)) (c1 (local.get $pref))))
          (let [$pb (call $buf-new (+ (c1 (local.get $pref)) 1))]
            (call $append (local.get $pb) (c0 (local.get $pref)) (c1 (local.get $pref)))
            (call $append (local.get $pb) "/")
            (when (not (call $starts-with (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4))
                             (buf-ptr (local.get $pb)) (buf-len (local.get $pb))))
              (local.set $rendered (num 0))))))
      ;; needle filter over "path title description"
      (when (and (local.get $rendered) (pos? (local.get $qn)))
        (local.set $hay (call $buf-new (num 128)))
        (call $append (local.get $hay) (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4)))
        (call $append (local.get $hay) " ")
        (call $append (local.get $hay) (i32.load (+ (local.get $r) 16)) (i32.load (+ (local.get $r) 20)))
        (call $append (local.get $hay) " ")
        (call $append (local.get $hay) (i32.load (+ (local.get $r) 24)) (i32.load (+ (local.get $r) 28)))
        (when (not (call $contains-ci (buf-ptr (local.get $hay)) (buf-len (local.get $hay))
                         (local.get $qp) (local.get $qn)))
          (local.set $rendered (num 0))))
      (when (local.get $rendered)
        (when (not= (local.get $keep) (local.get $i))
          (memory.copy (pg-at (local.get $list) (local.get $keep)) (local.get $r) (num 32)))
        (local.set $keep (inc (local.get $keep))))
      (local.set $i (inc (local.get $i))))
    (i32.store (+ (local.get $list) 4) (* (local.get $keep) 32))
    (local.set $total (local.get $keep))
    (when (zero? (local.get $total))
      (call $append (local.get $out) "no knowledge-base pages for ")
      (call $kb-label (local.get $out))
      (set-tool-count (num 0))
      (return))
    (local.set $shown ($if (> (local.get $total) (local.get $limit))
                           (local.get $limit) (local.get $total)))
    ;; header
    (if (< (local.get $shown) (local.get $total))
      (then
        (call $append-int (local.get $out) (local.get $shown))
        (call $append (local.get $out) " of ")
        (call $append-int (local.get $out) (local.get $total))
        (call $append (local.get $out) " pages in "))
      (else
        (call $append-int (local.get $out) (local.get $total))
        (call $append (local.get $out) " pages in ")))
    (call $kb-label (local.get $out))
    (call $append (local.get $out) " (")
    (call $append (local.get $out) (get-kb-origin-p) (get-kb-origin-n))
    (call $append (local.get $out) ")\n\n")
    (local.set $i (num 0))
    (while (< (local.get $i) (local.get $shown))
      (local.set $r (pg-at (local.get $list) (local.get $i)))
      (when (pos? (local.get $i)) (call $append (local.get $out) "\n\n"))
      (call $append-int (local.get $out) (inc (local.get $i)))
      (call $append (local.get $out) ". ")
      (call $append (local.get $out) (i32.load (local.get $r)) (i32.load (+ (local.get $r) 4)))
      (when (pos? (i32.load (+ (local.get $r) 20)))
        (call $append (local.get $out) "\n   ")
        (call $append (local.get $out) (i32.load (+ (local.get $r) 16)) (i32.load (+ (local.get $r) 20))))
      (when (pos? (i32.load (+ (local.get $r) 12)))
        (call $append (local.get $out) "\n   lastmod: ")
        (call $append (local.get $out) (i32.load (+ (local.get $r) 8)) (i32.load (+ (local.get $r) 12))))
      (when (pos? (i32.load (+ (local.get $r) 28)))
        (call $append (local.get $out) "\n   ")
        (call $append (local.get $out) (i32.load (+ (local.get $r) 24)) (i32.load (+ (local.get $r) 28))))
      (local.set $i (inc (local.get $i))))
    (call $append (local.get $out) "\n\nRead a page with knowledgebase_get using its path.")
    (set-tool-count (local.get $shown))))

;; content type indicates markdown? (or fall back to the .md suffix)
(func $is-md? (param $ctp i32) (param $ctn i32) (param $pp i32) (param $pn i32) (result i32)
  (when (>= (call $find-ci (local.get $ctp) (local.get $ctn) "markdown") 0) (return (num 1)))
  (when (>= (call $find-ci (local.get $ctp) (local.get $ctn) "text/plain") 0) (return (num 1)))
  (when (>= (call $find-ci (local.get $ctp) (local.get $ctn) "html") 0) (return (num 0)))
  (call $ends-with (local.get $pp) (local.get $pn) ".md"))

;; knowledgebase_get: renders into out; summary into sum
(func $kb-get (param $pp i32) (param $pn i32) (param $maxchars i32)
                (param $out i32) (param $sum i32)
  (let [$path 0 $ci 0 $cand 0 $urlb 0 $resp 0 $st 0 $ct 0 $b 0 $laststatus 0
        $lastct 0 $title 0 $u 0]
    (local.set $path (call $canon-path (local.get $pp) (local.get $pn) (local.get $out)))
    (when (zero? (local.get $path))
      (call $append (local.get $sum) (buf-ptr (local.get $out)) (buf-len (local.get $out)))
      (set-tool-err (num 1))
      (return))
    (local.set $lastct (call $cell (num 0) (num 0)))
    ;; candidates: "/" -> /index.md ; else path.md then path/index.md
    (local.set $ci (num 0))
    (while (< (local.get $ci) 2)
      (local.set $cand (call $buf-new (num 96)))
      (if (= (c1 (local.get $path)) 1)
        (then
          (call $append (local.get $cand) "/index.md")
          (local.set $ci (num 1)))
        (else
          (call $append (local.get $cand) (c0 (local.get $path)) (c1 (local.get $path)))
          (if (zero? (local.get $ci))
            (then (call $append (local.get $cand) ".md"))
            (else (call $append (local.get $cand) "/index.md")))))
      (local.set $urlb (call $buf-new (num 128)))
      (call $append (local.get $urlb) (get-kb-origin-p) (get-kb-origin-n))
      (call $append (local.get $urlb) (buf-ptr (local.get $cand)) (buf-len (local.get $cand)))
      (local.set $resp (call $kb-fetch (buf-ptr (local.get $urlb)) (buf-len (local.get $urlb))
                             "text/markdown, text/plain;q=0.9, */*;q=0.1"))
      (local.set $st (call $resp-status (local.get $resp)))
      (local.set $laststatus (local.get $st))
      (local.set $lastct (call $resp-ct (local.get $resp)))
      (when (not= (local.get $st) 404)
        (when (or (< (local.get $st) 200) (>= (local.get $st) 300))
          (call $append (local.get $out) "failed to fetch ")
          (call $append (local.get $out) (buf-ptr (local.get $cand)) (buf-len (local.get $cand)))
          (call $append (local.get $out) ": HTTP ")
          (call $append-int (local.get $out) (local.get $st))
          (call $append (local.get $sum) (buf-ptr (local.get $out)) (buf-len (local.get $out)))
          (set-tool-err (num 1))
          (return))
        (when (call $is-md? (c0 (local.get $lastct)) (c1 (local.get $lastct))
                    (buf-ptr (local.get $cand)) (buf-len (local.get $cand)))
          (local.set $b (call $resp-body (local.get $resp)))
          (local.set $u (call $resp-url (local.get $resp)))
          (when (zero? (c1 (local.get $u)))
            (local.set $u (call $cell (buf-ptr (local.get $urlb)) (buf-len (local.get $urlb)))))
          (local.set $title (call $md-title (c0 (local.get $b)) (c1 (local.get $b))))
          (call $append (local.get $out) "path: ")
          (call $append (local.get $out) (c0 (local.get $path)) (c1 (local.get $path)))
          (call $append (local.get $out) "\nurl: ")
          (call $append (local.get $out) (c0 (local.get $u)) (c1 (local.get $u)))
          (call $append (local.get $out) "\nstatus: ")
          (call $append-int (local.get $out) (local.get $st))
          (when (local.get $title)
            (call $append (local.get $out) "\ntitle: ")
            (call $append (local.get $out) (c0 (local.get $title)) (c1 (local.get $title))))
          (call $append (local.get $out) "\n")
          (call $truncate-append (local.get $out) (c0 (local.get $b)) (c1 (local.get $b)) (local.get $maxchars))
          (call $append-int (local.get $sum) (local.get $st))
          (call $append (local.get $sum) " ")
          (call $append (local.get $sum) (c0 (local.get $path)) (c1 (local.get $path)))
          (return)))
      (local.set $ci (inc (local.get $ci))))
    ;; nothing served markdown
    (if (= (local.get $laststatus) 404)
      (then
        (call $append (local.get $out) "path not found: ")
        (call $append (local.get $out) (c0 (local.get $path)) (c1 (local.get $path))))
      (else
        (call $append (local.get $out) "no markdown representation for ")
        (call $append (local.get $out) (c0 (local.get $path)) (c1 (local.get $path)))
        (call $append (local.get $out) " (HTTP ")
        (call $append-int (local.get $out)
          ($if (local.get $laststatus) (local.get $laststatus) (num 404)))
        (when (pos? (c1 (local.get $lastct)))
          (call $append (local.get $out) ", ")
          (call $append (local.get $out) (c0 (local.get $lastct)) (c1 (local.get $lastct))))
        (call $append (local.get $out) ")")))
    (call $append (local.get $sum) (buf-ptr (local.get $out)) (buf-len (local.get $out)))
    (set-tool-err (num 1))))
