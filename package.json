{
  "name": "fx-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI Responses API in front of the fx coding agent, running on edge runtimes",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node scripts/vendor-wasm.mjs",
    "build:wasm": "node scripts/vendor-wasm.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/vendor-wasm.mjs && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "libfx": "^0.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}
